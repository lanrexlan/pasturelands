# ---- Public site details (shown on the site; safe to expose)
NEXT_PUBLIC_SITE_URL=https://[Domain]
# Digits only, international format without "+", e.g. 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_PHONE=[Phone]
NEXT_PUBLIC_CONTACT_EMAIL=[Email]
NEXT_PUBLIC_OFFICE_ADDRESS=[Office address]

# ---- Supabase (Project settings > API). The anon / publishable key is public;
# RLS limits it to inserting leads/enquiries and reading published listings.
NEXT_PUBLIC_SUPABASE_URL=https://elcnbwipealjqugldoqc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, server only. Lets the team email include 14-day links to seller photos.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email (Resend)
RESEND_API_KEY=
# Must be on a domain verified in Resend. Until then onboarding@resend.dev only
# delivers to the Resend account owner's address.
EMAIL_FROM=Pasturelands <leads@[Domain]>
# Comma-separated
LEADS_EMAIL_TO=
# CEO, for investor enquiries (falls back to LEADS_EMAIL_TO)
INVESTOR_EMAIL_TO=

# ---- Optional: salt for hashing IP addresses used as rate-limit keys
RATE_LIMIT_SALT=
